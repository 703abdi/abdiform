# Admin dashboard password (required in production)
ADMIN_PASSWORD=
# Random string used to sign the login cookie (required in production). e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Postgres connection string (Supabase: Project Settings > Database > Connection string > Transaction pooler).
# Leave empty to use a local file store for development.
DATABASE_URL=

# Email alert on each new application (optional). Brevo transactional API key + a sender verified in Brevo.
BREVO_API_KEY=
NOTIFY_FROM_EMAIL=

# Simplest email setup: your own Gmail. Alerts for every new application go to this inbox,
# and automation emails are sent from it. GMAIL_APP_PASSWORD is a Google "app password"
# (myaccount.google.com/apppasswords), not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: send alerts somewhere else instead (comma separated)
NOTIFY_TO=
# Cron job secret for automations (any long random string)
CRON_SECRET=

# Email blasts (Brevo). The sender must be verified in Brevo (Senders, Domains): use your own domain,
# e.g. hello@tawakkultrading.com, so blasts don't land in spam.
BREVO_API_KEY=
BLAST_FROM_EMAIL=
BLAST_FROM_NAME=Tawakkul Trading
# Public site address used in unsubscribe links (set this once your domain is connected)
APP_URL=https://abdiform.vercel.app

# Calendly sync (calls, cancellations, no-shows -> contacts + tags).
# Calendly > Integrations & apps > API and webhooks > Personal access tokens
CALENDLY_TOKEN=
